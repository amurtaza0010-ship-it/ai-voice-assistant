# Groq (required for chat / agents)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=512

# OpenAI (optional — Whisper STT, TTS, and document embeddings for RAG)
OPENAI_API_KEY=

# Security
SECRET_KEY=replace-with-long-random-string

# Database (docker-compose default)
DATABASE_URL=postgresql+asyncpg://voiceai:voiceai@postgres:5432/voiceai

# Frontend (browser must reach API on host)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/chat
